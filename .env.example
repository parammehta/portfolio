NEXT_PUBLIC_WEBSITE_URL=https://parammehta.com
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
NEXT_PUBLIC_ANALYTICS_EVENTS_URL=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Server-only. The contact form endpoint (src/pages/api/message.api.ts) sends
# through SES; on Vercel it authenticates with these instead of the IAM role the
# old Lambda carried. Leave blank locally and the form will fail at the send
# step, which is usually what you want in development.
PORTFOLIO_AWS_ACCESS_KEY_ID=
PORTFOLIO_AWS_SECRET_ACCESS_KEY=
PORTFOLIO_AWS_REGION=us-east-1
CLOUDFLARE_TURNSTILE_SECRET=
