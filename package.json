  "author": "Param Mehta <param.mehta95@gmail.com>",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mapbox/rehype-prism": "^0.8.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/nextjs": "^10.5.5",
    "@svgr/webpack": "^6.5.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "~18.3",
    "@types/react-dom": "~18.3",
    "@types/three": "^0.185.3",
    "esbuild": "^0.15.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-storybook": "^10.5.5",
    "fs-extra": "^10.1.0",
    "globby": "^13.2.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "next-router-mock": "^1.0.5",
    "postcss": "^8.5.24",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^7.8.3",
    "prettier": "^3.9.6",
    "puppeteer": "^25.4.0",
    "reading-time": "^1.5.0",
    "rehype-img-size": "^1.0.1",
    "rehype-preset-minify": "^6.0.0",
    "rehype-slug": "^5.1.0",
    "serve": "^14.2.6",
    "storybook": "^10.5.5",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "framer-motion": "^7.10.3",
    "mdx-bundler": "^9.2.1",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && rm -rf build && mv out build",
    "build:storybook": "storybook build -o build-storybook && node scripts/draco-storybook",
    "start": "serve build",
    "storybook": "storybook dev -p 9009 -h localhost",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "deploy": "aws s3 sync --delete build/ s3://parammehta-portfolio-site && node scripts/invalidate-cloudfront",
    "deploy:storybook": "aws s3 sync --delete build-storybook s3://parammehta-portfolio-storybook && node scripts/invalidate-cloudfront-storybook",
    "deploy:functions": "cd functions && npm run deploy"
  },
  "browserslist": {
    "production": [
      ">10%",
      "not dead",
      "not ie 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "npm": ">=8.6.0",
    "node": ">=20.9.0"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  }
}
